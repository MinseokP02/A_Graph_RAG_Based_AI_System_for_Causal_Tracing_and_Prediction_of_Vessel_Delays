NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
CSV_PATH=data/port_calls/processed/port_calls_020_20260801_20260831_I_selected.csv
BATCH_SIZE=1000
DELAY_THRESHOLD_MINUTES=60
SOURCE_TIMEZONE=Asia/Seoul

# Query API (python -m middleware.query_api)
OLLAMA_URL=http://localhost:11434
QWEN_MODEL=qwen2.5:7b-instruct
LIGHTRAG_URL=http://localhost:9621
LIGHTRAG_QUERY_API_KEY=
MIDDLEWARE_HOST=127.0.0.1
MIDDLEWARE_PORT=9622
MIDDLEWARE_API_KEY=
QUERY_TIMEOUT=120
GRAPH_CONTEXT_CHARS=16000
DOCUMENT_CONTEXT_CHARS=8000

# Independent TFT API (python -m middleware.tft_api)
TFT_URL=http://localhost:9623
TFT_API_KEY=
TFT_TIMEOUT=30
TFT_HOST=127.0.0.1
TFT_PORT=9623
# These paths are produced by middleware.train_tft and middleware.tft_features.
TFT_CHECKPOINT=models/departure-delay.ckpt
TFT_FEATURES_PATH=data/tft/features.json
TFT_MODEL_VERSION=departure-delay-v1
TFT_MAX_FEATURE_AGE_SECONDS=3600
